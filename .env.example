# =============================================================================
# PharmaFlow — Environment Variables Template
# =============================================================================
# This file IS committed to Git. It shows every variable the project needs
# but with placeholder values — no real secrets here.
#
# HOW TO USE:
#   cp .env.example .env
#   # then fill in real values in .env (which is gitignored)
# =============================================================================

# ---------------------------------------------------------------------------
# MySQL (auth-service + payment-service)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=pharmaflow
MYSQL_PASSWORD=change_me_pass

# ---------------------------------------------------------------------------
# PostgreSQL (product-service + order-service)
# ---------------------------------------------------------------------------
POSTGRES_USER=pharmaflow
POSTGRES_PASSWORD=change_me_pass
POSTGRES_DB=postgres

# ---------------------------------------------------------------------------
# MongoDB (notification-service)
# ---------------------------------------------------------------------------
MONGO_ROOT_USERNAME=pharmaflow
MONGO_ROOT_PASSWORD=change_me_pass
MONGO_INITDB_DATABASE=pharmaflow-notifications

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ---------------------------------------------------------------------------
# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=replace_with_a_64_char_hex_secret

# ---------------------------------------------------------------------------
# Application ports
# ---------------------------------------------------------------------------
API_GW_PORT=3000
AUTH_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
PAYMENT_SERVICE_PORT=3005
GRPC_PORT_PRODUCT=50051
GRPC_PORT_ORDER=50052

# ---------------------------------------------------------------------------
# Per-service DATABASE_URLs (Docker service names used as hostnames)
# ---------------------------------------------------------------------------
AUTH_DATABASE_URL=mysql://pharmaflow:change_me_pass@mysql:3306/auth_service
PRODUCT_DATABASE_URL=postgresql://pharmaflow:change_me_pass@postgres:5432/product_service
ORDER_DATABASE_URL=postgresql://pharmaflow:change_me_pass@postgres:5432/order_service
PAYMENT_DATABASE_URL=mysql://pharmaflow:change_me_pass@mysql:3306/payment_service
MONGO_URI=mongodb://pharmaflow:change_me_pass@mongo:27017/pharmaflow-notifications?authSource=admin

# ---------------------------------------------------------------------------
# Redis URL (internal Docker network)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Grafana (Loki + Grafana logging stack)
# Grafana UI: http://localhost:3200
# ---------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana

# ---------------------------------------------------------------------------
# Logging service (RabbitMQ consumer → Loki)
# ---------------------------------------------------------------------------
LOKI_URL=http://loki:3100
BATCH_SIZE=50
FLUSH_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# Health-check service
# ---------------------------------------------------------------------------
HEALTH_CHECK_INTERVAL_MS=30000
